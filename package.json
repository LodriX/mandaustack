{
  "name": "mandaustack",
  "version": "0.1.6",
  "private": true,
  "description": "A free, open-source local development environment for macOS and Windows",
  "author": "MandauStack Contributors",
  "license": "MIT",
  "main": "dist-electron/electron/main.js",
  "bin": {
    "mandaustack": "dist-electron/cli.js"
  },
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run typecheck && npm run build:main && vite build",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "npm run build:main && node --test dist-electron/core/*.test.js",
    "start": "electron .",
    "cli": "npm run build:main && node dist-electron/cli.js",
    "icons": "node scripts/generate-icons.mjs",
    "package:mac": "npm run build && npm run icons && electron-builder --mac",
    "package:win": "npm run build && npm run icons && electron-builder --win"
  },
  "dependencies": {
    "node-forge": "^1.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tar": "^7.5.22",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "concurrently": "^9.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "wait-on": "^9.0.3",
    "yazl": "^3.3.1"
  },
  "build": {
    "appId": "dev.mandaustack.app",
    "productName": "MandauStack",
    "copyright": "Copyright © 2026 MandauStack Contributors",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "minimumSystemVersion": "14.0",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  }
}
